{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./", 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["jest", "node", "supertest"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    "src/**/*",
    "tests/**/*",   // Add this if your tests are in a 'tests' folder
    "**/*.test.ts", // Add this to catch all .test.ts files
    "**/*.spec.ts"  // Add this to catch all .spec.ts files
  ],
  "exclude": ["node_modules", "dist"]
}
